# Negar acceso a cualquier archivo en este directorio
# Las imágenes deben servirse a través del endpoint /uploads/
# Configurado en Apache con AllowOverride None en el VirtualHost

# Pero por defecto en hosting compartido permitimos servir las imágenes:
Options -Indexes

# Bloquear ejecución de PHP dentro de uploads (seguridad anti-shell)
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps)$">
    Require all denied
</FilesMatch>

# Tipos MIME comunes
<IfModule mod_mime.c>
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
    AddType image/webp .webp
</IfModule>
