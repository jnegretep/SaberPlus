# ─────────────────────────────────────────────────────────────
# Saber+ Backend — Configuración de entorno (PLANTILLA)
# ─────────────────────────────────────────────────────────────
# 1. Copia este archivo como .env en esta misma carpeta:
#      cp .env.example .env
# 2. Rellena los valores REALES (los que estaban antes en el código).
# 3. .env está en .gitignore — NUNCA se sube a git.
#
# ⚠️ IMPORTANTE — ROTACIÓN DE CREDENCIALES:
# Los valores anteriores estuvieron expuestos en el repositorio
# público de GitHub. Antes de ponerlos aquí, ROTÁLOS en su
# plataforma correspondiente (Wompi, Gmail, servidor, Moodle).
# Ver: GUÍA_DE_SEGURIDAD.md (paso a paso).
# ─────────────────────────────────────────────────────────────

# ── Base de datos MySQL ──
DB_HOST=localhost
DB_NAME=prepsaber
DB_USER=usuario_de_la_bd
DB_PASS=cambia_esta_contraseña

# ── Secreto JWT (genera uno nuevo: openssl rand -hex 32) ──
JWT_SECRET=genera_un_secreto_aleatorio_de_64_caracteres_hex

# ── Moodle (LMS) ──
MOODLE_BASE_URL=https://preicfes.tudominio.edu.co
MOODLE_WS_TOKEN=token_del_webservice_de_moodle

# ── Backend (URLs públicas, no son secretas) ──
BACKEND_BASE_URL=https://tudominio.com/api/prepsaber/backend

# ── Wompi (pasarela de pagos) ──
# ⚠️ ROTAR OBLIGATORIAMENTE en el panel de Wompi antes de usar
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=prod_events_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxxxxxx

# ── SMTP (envío de correos) ──
SMTP_HOST=smtp.gmail.com
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=app_password_de_16_caracteres
SMTP_SECURE=tls
SMTP_PORT=587
SMTP_FROM=tucorreo@gmail.com
SMTP_FROM_NAME=Saber+

# ── DeepSeek (tutor IA) ──
# ⚠️ ROTAR OBLIGATORIAMENTE en platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Panel de administración (/admin) ──
ADMIN_USER=admin
ADMIN_PASS=cambia_esta_contraseña

# ── Token interno para crons y scripts administrativos ──
# Cualquier string largo y aleatorio (openssl rand -hex 32).
# Los cron jobs deben llamar con cabecera: X-Internal-Token: <valor>
INTERNAL_TOKEN=genera_un_token_aleatorio_largo
