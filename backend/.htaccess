# TRAZA - Apache .htaccess
# Reescritura de URLs y seguridad

RewriteEngine On

# Redirigir a HTTPS (descomentar en producción)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# API routing: /api/xxx -> /api/xxx.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/$1.php [QSA,L]

# Servir archivos de uploads directamente
RewriteCond %{REQUEST_URI} ^/uploads/
RewriteRule ^uploads/(.*)$ uploads/$1 [L]

# Seguridad: bloquear acceso a archivos sensibles
<FilesMatch "\.(php|sql|env|log|md)$">
    # Permitir solo api/
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^ - [F]
</FilesMatch>

# No listar directorios
Options -Indexes

# CORS headers para Flutter Web (v1.6.0)
# Nota: cada endpoint PHP también envía sus propios headers CORS;
# esto es una capa extra para archivos estáticos y respaldos.
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Internal-Token"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Responder inmediatamente a las peticiones preflight OPTIONS (v1.6.0)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^OPTIONS$
    RewriteRule ^ - [R=204,L]
</IfModule>

# Cache de imágenes subidas (1 semana)
<IfModule mod_expires.c>
    ExpiresActive On
    <Directory "uploads">
        ExpiresByType image/jpeg "access plus 1 week"
        ExpiresByType image/png "access plus 1 week"
        ExpiresByType image/webp "access plus 1 week"
    </Directory>
</IfModule>

# PHP settings
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
</IfModule>