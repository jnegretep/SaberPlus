# ── Saber+ Environment Config (TEMPLATE) ──
# Copia este archivo como .env y rellena los valores reales
# ⚠️ .env está en .gitignore — nunca se sube a git
#
# 🆕 DESDE 2026-09 — OPCIÓN RECOMENDADA: compilar SIN empaquetar .env
# La clase Env ahora soporta --dart-define (prioridad sobre .env):
#
#   flutter build apk --release \
#     --dart-define=API_BASE_URL=https://tudominio.com/api/prepsaber/backend \
#     --dart-define=AVATAR_BASE_URL=https://tudominio.com/api/prepsaber/backend/uploads/avatars/ \
#     --dart-define=DEFAULT_AVATAR_URL=https://tudominio.com/api/prepsaber/backend/uploads/avatars/default_avatar.png \
#     --dart-define=AI_API_URL=https://tudominio.com/api/prepsaber/backend/api_saber_plus_ia.php
#
# Cuando pases todos los valores por --dart-define, puedes quitar
# `- .env` de la sección assets del pubspec.yaml (el APK queda más limpio
# y sin URLs extraíbles).

# API Backend
API_BASE_URL=https://tudominio.com/api/prepsaber/backend
AVATAR_BASE_URL=https://tudominio.com/api/prepsaber/backend/uploads/avatars/
DEFAULT_AVATAR_URL=https://tudominio.com/api/prepsaber/backend/uploads/avatars/default_avatar.png
AI_API_URL=https://tudominio.com/api/prepsaber/backend/api_saber_plus_ia.php

# Firebase Web (solo para web build)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Opcional (v1.6.0) — push web vía VAPID. Si se deja vacío,
# las notificaciones push quedan deshabilitadas en web.
FIREBASE_VAPID_KEY=
